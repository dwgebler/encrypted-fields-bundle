<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Gebler\EncryptedFieldsBundle\Entity\EncryptionKey" table="encryption_key" repository-class="Gebler\EncryptedFieldsBundle\Repository\EncryptionKeyRepository">
        <id name="id" type="bigint" column="id">
            <generator strategy="IDENTITY"/>
        </id>
        <field name="entityClass" type="string" length="255" column="entity_class"/>
        <field name="entityId" type="string" length="255" column="entity_id"/>
        <!-- Ciphertext length is unbounded (depends on plaintext); TEXT avoids truncation. -->
        <field name="key" type="text" column="encryption_key"/>
        <field name="masterEncrypted" type="boolean" column="master_encrypted"/>
        <unique-constraints>
            <unique-constraint name="uniq_encryption_key_entity" columns="entity_class,entity_id"/>
        </unique-constraints>
    </entity>

</doctrine-mapping>
